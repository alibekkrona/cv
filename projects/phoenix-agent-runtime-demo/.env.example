OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

AGENT_MAX_FILE_BYTES=200000
AGENT_ALLOW_WRITE=true
AGENT_ALLOW_RUN=true

AGENT_TELEGRAM_BOT_TOKEN=
AGENT_TELEGRAM_CHAT_ID=

AGENT_EXECUTION_PROFILE=intensive
AGENT_ALLOW_PROTECTED_BRANCH_WRITE=false
AGENT_AUTO_APPROVE_FILE_WRITE=true
AGENT_AUTO_APPROVE_DRAFT_APPLY=true
AGENT_AUTO_APPROVE_GIT=true

PHOENIX_REGISTRY_ENABLED=false
PHOENIX_REGISTRY_REPO_ROOT=
PHOENIX_REGISTRY_BASE_PATH=.ai/registry
PHOENIX_REGISTRY_TOMES=CORE,AGENT
# Example:
# PHOENIX_REGISTRY_TOMES=CORE,AGENT,TELEGRAM,LOBBYSCRAPER
# Agent works with tome-based registry structure:
# .ai/registry/_INDEX.md
# .ai/registry/<TOME>/_INDEX.md
# .ai/registry/<TOME>/CONVERSATION.md   (read-only for agent)
# .ai/registry/<TOME>/ROADMAP.md
# .ai/registry/<TOME>/<TOME>-NNN.md
OPENAI_CONVERSATION_ENABLED=false
OPENAI_CONVERSATION_ID=
OPENAI_CONVERSATION_METADATA_TOPIC=local-agent
AGENT_VERBOSE_REPORT=false

AGENT_OPS_ENABLED=true
AGENT_OPS_REPO_ROOT=/absolute/path/to/agent_ops_repo
AGENT_OPS_REMOTE=origin
AGENT_OPS_BRANCH=main

AGENT_OPS_GIT_ENABLED=false
AGENT_OPS_GIT_AUTO_COMMIT=false
AGENT_OPS_GIT_AUTO_PUSH=false
# AUTO_PUSH requires AUTO_COMMIT=true
AGENT_OPS_GIT_REMOTE=origin
AGENT_OPS_GIT_BRANCH=main
